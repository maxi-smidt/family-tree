# Local backend configuration. Copy to backend/.env — it's then loaded
# automatically (from anywhere), so no manual `export`s are needed:
#
#   cd backend && cp .env.example .env
#   uv run uvicorn app.main:app --reload --port 8000
#
# Real environment variables still override these values.

SECRET_KEY=dev-secret

# Database — SQLite is the zero-setup default for local dev (no DB to run).
# Switch to a local Postgres (see docs/SETUP.md for a docker run) to match prod:
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg2://familytree:familytree@localhost:5432/familytree

# Where photos/media (DATA_PATH) and app working data (APP_DATA_PATH) are
# written, relative to the backend/ directory.
DATA_PATH=./.data
APP_DATA_PATH=./.appdata

# Match the Vite dev server origin (so CORS + OAuth redirects line up).
FRONTEND_URL=http://localhost:1420
CORS_ORIGINS=http://localhost:1420

# Optional — the seeded admin (defaults to admin / admin).
# FIRST_ADMIN_USERNAME=admin
# FIRST_ADMIN_PASSWORD=admin
