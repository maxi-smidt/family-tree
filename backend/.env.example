# Local backend configuration. Copy to backend/.env — it's loaded automatically
# (from any working directory), so no manual `export`s are needed. Real
# environment variables still override these values.
#
# By default the backend connects to Postgres on localhost:5432 with the default
# credentials — i.e. the database started by `docker compose up -d db`. So for a
# standard dev setup the only thing you need here is a dev secret.

SECRET_KEY=dev-secret

# Initial admin — seeded on the first startup against an empty database. In dev
# this defaults to admin / admin; uncomment to choose your own (must be set
# BEFORE the first boot; it does not update an already-seeded admin).
# FIRST_ADMIN_USERNAME=admin
# FIRST_ADMIN_PASSWORD=admin

# --- Overrides (uncomment only when you change a default) ------------------

# No database running? Use SQLite for a zero-setup run:
# DATABASE_URL=sqlite:///./dev.db

# Custom DB credentials — must match docker-compose / the root .env:
# POSTGRES_USER=familytree
# POSTGRES_PASSWORD=familytree
# POSTGRES_DB=familytree

# Where media (DATA_PATH) and app working data (APP_DATA_PATH) are written,
# relative to the backend/ directory:
# DATA_PATH=./.data
# APP_DATA_PATH=./.appdata

# Only needed if you enable Authentik OAuth in dev (for the redirect/CORS):
# FRONTEND_URL=http://localhost:1420
# CORS_ORIGINS=http://localhost:1420
