# ---------------------------------------------------------------------------
# Family Tree configuration. Copy to ".env" and adjust.
#
# This single file configures both docker-compose deployments and a locally
# run dev backend (backend/app loads it from the repo root automatically).
# Real environment variables always override values from this file.
# ---------------------------------------------------------------------------

# Host port the web UI is served on.
UI_PORT=8080

# Host path for application data (backend working data: exports, logs, ...).
APP_DATA_PATH=./appdata

# Host path for the "real" data (member photos and gallery media).
DATA_PATH=./data

# Image tag used by docker-compose.prod.yml for both app containers.
# Use "latest" for the latest published release, or pin a release like "1.2.17".
APP_IMAGE_TAG=latest

# Controls startup credential validation. The shipped docker-compose files set
# this to "production" themselves (injected env vars win over this file), so
# real deployments reject placeholder/weak signing and initial-admin
# credentials regardless of the value here. Left as "development" so a host-run
# dev backend (`uv run uvicorn ...`) starts with the example secrets below; set
# "production" if you run the backend outside the provided compose stack.
ENVIRONMENT=development

# Secret used to sign JWTs and the OAuth session. REQUIRED — generate one with:
#   openssl rand -hex 32
SECRET_KEY=change-me-please-generate-a-long-random-value

# Public URL the UI is reached at (used for OAuth redirects and CORS).
# Should match http://<host>:${UI_PORT} (or your reverse-proxied domain).
# For local development (Vite on :1420) use http://localhost:1420 instead.
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# --- Database ----------------------------------------------------------------
# PostgreSQL is NOT part of the compose stack — point these at your own
# Postgres instance (e.g. a separate container/app on Unraid).
# For development, `docker compose -f docker-compose.dev.yml up -d db` starts a
# throwaway Postgres on localhost:5432 that matches these defaults.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=familytree
POSTGRES_PASSWORD=familytree
POSTGRES_DB=familytree
# Alternatively provide a full connection URL (takes precedence over the
# POSTGRES_* values above):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
#
# Connection pool sizing (optional). Defaults shown. QueuePool keeps
# DB_POOL_SIZE persistent connections and allows up to DB_MAX_OVERFLOW extra
# under load. Ensure (DB_POOL_SIZE + DB_MAX_OVERFLOW) * WORKERS stays below your
# Postgres max_connections (default 100). DB_POOL_RECYCLE (seconds) recycles
# connections to avoid stale ones behind an idle-timeout proxy.
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800

# --- Redis (optional, external) ----------------------------------------------
# Redis is NOT part of the compose stack — point the backend at your own
# Redis instance via REDIS_URL.  Leave unset (or empty) to run without Redis;
# all features degrade gracefully.  Supported URL formats:
#   REDIS_URL=redis://localhost:6379/0          # plain, local
#   REDIS_URL=rediss://host:6380/0              # TLS
#   REDIS_URL=redis://:password@host:6379/0     # with password
# REDIS_URL=
#
# WORKERS sets the number of uvicorn worker processes (default 1). WORKERS > 1
# REQUIRES REDIS_URL — without it, SSE events published by one worker never
# reach clients connected to another. Keep
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) * WORKERS below Postgres max_connections.
# WORKERS=1

# --- Initial admin (created on first start if no users exist) ---------------
# FIRST_ADMIN_PASSWORD must be at least 12 UTF-8 bytes for local-auth
# production deployments. Missing and placeholder values are rejected at startup.
# Skipped when Authentik is configured below: in that case admins are granted
# through the AUTHENTIK_ADMIN_GROUP on first OIDC login instead.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=change-me
FIRST_ADMIN_EMAIL=admin@example.com

# Allow visitors to register their own accounts (admins can toggle at runtime).
ALLOW_SELF_REGISTRATION=false

# --- Authentik (OIDC) — optional. Leave blank to disable. -------------------
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# OpenID configuration URL, e.g.
#   https://authentik.example.com/application/o/family-tree/.well-known/openid-configuration
AUTHENTIK_DISCOVERY_URL=
# Group whose membership is synced on every Authentik login (grants and revokes admin).
# Leave blank to disable admin sync entirely.
AUTHENTIK_ADMIN_GROUP=family-tree-admins
